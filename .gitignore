# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.local.h
firmware/include/Secrets.h
secrets/
*.pem
*.key
!**/*.example.*

# --- PlatformIO / firmware ---
.pio/
.pioenvs/
.piolibdeps/
firmware/.pio/
*.bin
*.elf
*.map
!firmware/releases/**/*.bin

# --- Node ---
node_modules/
dist/
build/
coverage/
*.log
npm-debug.log*

# --- Capacitor / Android ---
# app/android/ IS committed. It carries hand-edited files that `cap add android`
# would otherwise regenerate away - notably the network security config that
# permits cleartext HTTP to the ESP32 on the LAN. Only build output is ignored.
app/android/app/build/
app/android/build/
app/android/.gradle/
app/android/local.properties
app/android/capacitor-cordova-android-plugins/
app/ios/
app/.capacitor/
*.apk
*.aab
local.properties
.gradle/

# --- Editors / OS ---
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# TypeScript incremental build cache
*.tsbuildinfo

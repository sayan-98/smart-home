# ---------------------------------------------------------------------------
#  Smart Home OS backend - copy to .env and fill in.
#  Never commit .env. The Groq key in particular must never reach the app or
#  the firmware; an APK is trivially unpacked and an ESP32 cannot keep a secret.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# --- Supabase (free tier) --------------------------------------------------
# Project Settings -> Database -> Connection string.
# DATABASE_URL is the POOLED connection (port 6543) used at runtime.
# DIRECT_URL is the DIRECT connection (port 5432) used by prisma migrate -
# migrations against the pooler fail in confusing ways.
#
# Note: the free tier PAUSES after 7 days with no activity. The /health
# keep-warm ping below also keeps this from happening.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- auth ------------------------------------------------------------------
# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_EXPIRES_IN=30d

# --- MQTT ------------------------------------------------------------------
# Render's free tier CANNOT host a broker: no raw TCP ports, and it sleeps.
# Use HiveMQ Cloud Serverless (free, always on, ~100 connections, TLS-only)
# or EMQX Serverless. Because they are TLS-only, the firmware must have
# mqttTls=true for any cloud deployment.
#
# Local development with infra/docker-compose.yml:
#   MQTT_URL=mqtt://localhost:1883
MQTT_URL=mqtts://xxxxx.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=backend
MQTT_PASSWORD=
MQTT_TOPIC_ROOT=smarthome

# --- Groq (AI features) ----------------------------------------------------
# Backend only. Leave blank to disable AI entirely - the app then greys out
# those features and everything else works normally.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
AI_RATE_LIMIT_PER_MINUTE=10

# --- retention -------------------------------------------------------------
# A 30 s heartbeat is ~1 M rows per device per year and the Supabase free tier
# is 500 MB, so this is what keeps the project inside its budget.
EVENT_RETENTION_DAYS=30

# --- misc ------------------------------------------------------------------
# Comma-separated, or * for any origin. The Capacitor app runs from
# capacitor://localhost and http://localhost on Android.
CORS_ORIGINS=*
PUBLIC_BASE_URL=https://your-app.onrender.com
